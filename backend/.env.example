# Qdrant Database Configuration
QDRANT_URL=<qdrant_url>
QDRANT_API_KEY=<qdrant_api_key>
COLLECTION_NAME=docpilot

# Embedding Configuration
# For Render / Low-Memory: models/gemini-embedding-001 (3072 dimensions)
# For Local: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=3072

# Chunking Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Gemini LLM Configuration
GEMINI_API_KEY=<your_api_key>
LLM_MODEL=gemini-3.5-flash-lite

ALLOWED_ORIGINS=["http://localhost:5173"]

# ─── Relational Database (users, sessions, document metadata) ──────────────
# SQLite is fine for local dev. Use Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg://docpilot:password@localhost:5432/docpilot
DATABASE_URL=sqlite:///./docpilot.db

# ─── Auth / JWT ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=<replace_with_a_random_64_char_hex_secret>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=docpilot_refresh_token

# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ─── Google OAuth (Sign in with Google) ───────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: http://localhost:5173 (and your prod domain)
GOOGLE_CLIENT_ID=<your_google_oauth_client_id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your_google_oauth_client_secret>

FRONTEND_URL=http://localhost:5173
